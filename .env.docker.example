# Copy this file to .env before running `docker compose up --build`.
# Every value below is required; the app ships with no demo data or demo logins.

# MySQL root password (database administration only)
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_database_password

# Password for the application database account created by MySQL on first start
DB_PASSWORD=replace_with_another_long_random_password

# First administrator account, created automatically on first API start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_different_password_at_least_12_chars
ADMIN_NAME=Administrator

# Host port the web interface is published on
APP_PORT=8080
